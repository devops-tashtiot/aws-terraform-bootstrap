# Local .terraform directories
.terraform/

# Terraform state files (bootstrap tfstate is intentionally committed — see README)
*.tfstate.*
*.tfstate.backup

# Terraform lock file (keep .terraform.lock.hcl if you want reproducible provider versions)
# .terraform.lock.hcl

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash log
crash.log
crash.*.log

# Override files (local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan

# SSH keys
*.pem
*.key

# Environment variable files
.env
.env.*
